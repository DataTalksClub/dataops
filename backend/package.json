{
  "name": "dataops-backend",
  "version": "0.1.0",
  "description": "DataOps single backend for operations tasks, workflows, docs, and search backed by DynamoDB",
  "main": "dist/handler.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "IS_LOCAL=true tsx watch scripts/dev-server.ts",
    "test": "NODE_ENV=test FRONTEND_ROOT=../frontend SKIP_AUTH=true CONVERSATIONAL_TELEGRAM_INGRESS_ENABLED=false CONVERSATIONAL_EXECUTION_ENABLED=false CONVERSATIONAL_ENABLED_PLUGINS=none CONVERSATIONAL_TYPEFULLY_EXTERNAL_EXECUTION_ENABLED=false CONVERSATIONAL_TELEGRAM_VOICE_ENABLED=false CONVERSATIONAL_TELEGRAM_PHOTO_ENABLED=false node --import tsx --test --test-force-exit tests/*.test.ts scripts/frontend-capabilities.test.mjs",
    "test:execution-transaction": "bash scripts/test-conversational-execution-transaction.sh",
    "test:telegram-transaction": "bash scripts/test-telegram-transaction.sh",
    "test:sponsor-finance-transaction": "bash scripts/test-sponsor-finance-transaction.sh",
    "test:sponsor-communications-transaction": "bash scripts/test-sponsor-communications-transaction.sh",
    "test:todo-transaction": "bash scripts/test-todo-transaction.sh",
    "test:typefully-transaction": "bash scripts/test-typefully-transaction.sh",
    "test:e2e": "npx playwright test",
    "test:frontend-artifact": "make -C .. sam-build && node --test scripts/frontend-artifact.test.mjs",
    "test:e2e:frontend-parity": "node scripts/frontend-parity.mjs",
    "test:integration": "bash scripts/integration-test.sh",
    "build": "tsc && rm -rf dist/frontend dist/pages dist/public dist/static dist/assets && node scripts/copy-frontend-artifact.mjs --source ../frontend --artifact dist && node scripts/verify-frontend-artifact.mjs --source ../frontend --artifact dist",
    "start": "IS_LOCAL=true tsx scripts/dev-server.ts",
    "seed": "IS_LOCAL=true tsx scripts/seed-templates.ts",
    "seed:users": "IS_LOCAL=true tsx scripts/seed-users.ts",
    "seed:recurring": "IS_LOCAL=true tsx scripts/seed-recurring.ts",
    "export:data": "IS_LOCAL=true tsx scripts/export-execution-data.ts",
    "build:google-doc-map": "tsx scripts/build-google-doc-map.ts",
    "check:google-doc-map": "tsx scripts/build-google-doc-map.ts --check",
    "validate:docs-links": "tsx scripts/validate-docs-links.ts --repo-root .. --content-root content",
    "validate:export": "tsx scripts/validate-execution-export.ts",
    "dry-run:import": "tsx scripts/dry-run-import.ts",
    "bookkeeping:import": "tsx scripts/import-bookkeeping.ts",
    "bookkeeping:documents:import": "tsx scripts/import-bookkeeping-documents.ts",
    "calendar:import": "tsx scripts/import-calendar.ts",
    "sponsor-crm:migrate": "tsx scripts/migrate-sponsor-crm.ts",
    "restore:drill": "tsx scripts/restore-drill.ts",
    "cron": "IS_LOCAL=true tsx scripts/cron-runner.ts",
    "build:search-index": "tsx scripts/build-search-index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.scripts.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.996.0",
    "@aws-sdk/client-secrets-manager": "3.996.0",
    "@aws-sdk/client-sesv2": "^3.1098.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "exceljs": "^4.4.0",
    "gray-matter": "^4.0.3",
    "jpeg-js": "^0.4.4",
    "js-yaml": "^4.3.1",
    "yauzl": "3.4.0",
    "yazl": "^3.3.1",
    "zerosearch-node": "file:vendor/zerosearch-node"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^18.19.130",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.5",
    "dynalite": "^3.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "keywords": [],
  "license": "ISC"
}
