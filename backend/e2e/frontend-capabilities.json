{
  "schemaVersion": 2,
  "contract": "canonical-frontend-capability-coverage",
  "stateRoleSemantics": "A state with roleIds requires passing evidence for every listed role; otherwise one passing role inherited from the capability is sufficient.",
  "evidencePolicy": {
    "acceptedType": "same-run-playwright-annotation",
    "forbiddenTypes": [
      "api-only",
      "marker-only",
      "parity-only",
      "screenshot-only",
      "source-string"
    ],
    "browserInterceptionAllowed": false
  },
  "roles": [
    {
      "id": "signed-out",
      "description": "No authenticated browser session."
    },
    {
      "id": "expired-session",
      "description": "A browser session that is no longer valid."
    },
    {
      "id": "disabled-user",
      "description": "An authenticated identity whose account is disabled."
    },
    {
      "id": "operator",
      "description": "An enabled authenticated operator."
    },
    {
      "id": "admin",
      "description": "An enabled authenticated administrator."
    }
  ],
  "capabilities": [
    {
      "id": "session",
      "surface": "Session boundary",
      "route": "/login | /logout",
      "apiBoundaries": [
        "/api/me",
        "/api/*",
        "/work/api/*"
      ],
      "roleIds": [
        "signed-out",
        "expired-session",
        "disabled-user",
        "operator",
        "admin"
      ],
      "states": [
        {
          "id": "session.signed-out-redirect",
          "kind": "permission",
          "roleIds": [
            "signed-out"
          ],
          "description": "Signed-out page navigation uses the shared login redirect.",
          "coverage": {
            "status": "runtime"
          }
        },
        {
          "id": "session.expired-denied",
          "kind": "permission",
          "roleIds": [
            "expired-session"
          ],
          "description": "An expired session is denied without a frontend fallback.",
          "coverage": {
            "status": "runtime"
          }
        },
        {
          "id": "session.disabled-denied",
          "kind": "permission",
          "roleIds": [
            "disabled-user"
          ],
          "description": "A disabled user is denied without rendering the workspace.",
          "coverage": {
            "status": "runtime"
          }
        },
        {
          "id": "session.operator-cookie-ready",
          "kind": "ready",
          "roleIds": [
            "operator"
          ],
          "description": "An operator loads through the HttpOnly browser cookie and /api/me.",
          "coverage": {
            "status": "runtime"
          }
        },
        {
          "id": "session.admin-cookie-ready",
          "kind": "ready",
          "roleIds": [
            "admin"
          ],
          "description": "An admin loads through the HttpOnly browser cookie and server-derived role.",
          "coverage": {
            "status": "runtime"
          }
        },
        {
          "id": "session.api-json-denial",
          "kind": "error",
          "roleIds": [
            "signed-out",
            "expired-session",
            "disabled-user"
          ],
          "description": "Unauthenticated /api and /work/api requests return JSON and never the shell.",
          "coverage": {
            "status": "runtime"
          }
        },
        {
          "id": "session.no-bearer-fallback",
          "kind": "permission",
          "roleIds": [
            "operator",
            "admin"
          ],
          "description": "The browser does not use bearer-token or local-storage authentication.",
          "coverage": {
            "status": "runtime"
          }
        }
      ]
    },
